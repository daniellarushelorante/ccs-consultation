<%- include('../partials/header') %>
<div class="page-head"><div><h1>My availability</h1><p>Students can only book the 30-minute slots listed here.</p></div></div>

<div class="week">
  <% byDay.forEach(function (d) { %>
    <section class="day-col">
      <h3><%= d.day %></h3>
      <% if (!d.slots.length) { %><p class="muted">No slots</p><% } else { %>
        <ul>
          <% d.slots.forEach(function (s) { %>
            <li><%= s.label %>
              <form method="post" action="/faculty/availability/<%= s.id %>/delete">
                <button class="x-btn" type="submit" aria-label="Remove <%= d.day %> <%= s.label %>">&times;</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% }) %>
</div>

<section class="panel">
  <h2>Add a slot</h2>
  <p>Pick a weekday and a start time.</p>
  <form class="inline-form" method="post" action="/faculty/availability/add">
    <div class="field"><label for="day">Day</label>
      <select id="day" name="day" required><% weekdays.forEach(function (d) { %><option><%= d %></option><% }) %></select>
    </div>
    <div class="field"><label for="time">Start time</label>
      <select id="time" name="time" required><% timeOptions.forEach(function (t) { %><option value="<%= t.value %>"><%= t.label %></option><% }) %></select>
    </div>
    <button class="btn" type="submit">Add slot</button>
  </form>
</section>

<section class="panel">
  <h2>Away from campus</h2>
  <p><%= leaveUntil ? 'You are marked on leave until ' + fmt.short(leaveUntil) + '. Students cannot book you until then.' : 'Set a return date to stop new bookings. Leave it empty to be bookable.' %></p>
  <form class="inline-form" method="post" action="/faculty/availability/leave">
    <div class="field"><label for="return_date">Return date</label>
      <input id="return_date" name="return_date" type="date" min="<%= minLeave %>" value="<%= leaveUntil %>">
    </div>
    <button class="btn" type="submit"><%= leaveUntil ? 'Update' : 'Save' %></button>
  </form>
</section>
<%- include('../partials/footer') %>

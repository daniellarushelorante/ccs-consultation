<%- include('../partials/header') %>
<div class="page-head"><div><h1>Requests</h1><p>Approve or decline what students have booked.</p></div></div>

<section class="section">
  <h2>Pending <span class="count"><%= pending.length %></span></h2>
  <% if (!pending.length) { %>
    <div class="empty">Nothing to review right now.</div>
  <% } else { %>
    <div class="slips">
      <% pending.forEach(function (p) { var parts = fmt.short(p.appt_date).split(' '); %>
        <article class="slip">
          <div class="slip-date"><small><%= parts[0] %></small><b><%= parts[1] %></b></div>
          <div class="slip-body">
            <h3><%= p.full_name %></h3>
            <p><%= p.program %>, Year <%= p.year_level %></p>
            <p><span class="time"><%= fmt.withDay(p.appt_date) %>, <%= fmt.time(p.slot_time) %></span> &middot; <%= p.topic %></p>
          </div>
          <div class="slip-actions">
            <form method="post" action="/faculty/requests/<%= p.id %>/approve"><button class="btn small" type="submit">Approve</button></form>
            <form method="post" action="/faculty/requests/<%= p.id %>/decline"><button class="btn danger small" type="submit">Decline</button></form>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="section">
  <h2>History</h2>
  <% if (!history.length) { %>
    <div class="empty">Handled requests will appear here.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Date</th><th>Time</th><th>Student</th><th>Topic</th><th>Status</th></tr></thead>
        <tbody>
          <% history.forEach(function (h) { %>
            <tr>
              <td><%= fmt.withDay(h.appt_date) %></td>
              <td><%= fmt.time(h.slot_time) %></td>
              <td><%= h.full_name %> <span class="muted">(<%= h.program %> <%= h.year_level %>)</span></td>
              <td><%= h.topic %></td>
              <td><span class="pill <%= h.status %>"><%= h.status.charAt(0).toUpperCase() + h.status.slice(1) %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
